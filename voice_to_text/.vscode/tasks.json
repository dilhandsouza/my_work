{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Voice to Text App",
      "type": "shell",
      "command": "python",
      "args": ["main.py"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "pip",
      "args": ["install", "-r", "requirements.txt"],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
